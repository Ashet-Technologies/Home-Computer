         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NL7SZ57 - Configurable Multifunction Gate</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NL7SZ57 is an advanced highâˆ’speed CMOS multifunction gate. The device allows the user to choose logic functions AND, OR, NAND, NOR, XNOR, INVERT and BUFFER. The device has Schmittâˆ’trigger inputs, thereby enhancing noise immunity.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:13c33074-3197-4945-b2cf-7d9e8b0b4e3a</xmpMM:DocumentID>
