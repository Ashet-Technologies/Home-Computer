	(text "Power Indicator"
		(exclude_from_sim no)
		(at 45.72 170.815 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "29b6ad73-499a-4db8-9fd7-076943e2620e")
	)
	(text_box "We use an AND gate to enable/disable the clock signal on the card.\nThis gives us the benefit that the clock is defined GND when disabled instead of floating."
		(exclude_from_sim no)
		(at 15.875 119.9963 0)
		(size 25.4 13.3537)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "2250b367-f164-4a0a-b939-46a65dd89e27")
	)
	(text_box "The TPS2051B gives us short circuit protection and automatic shutdown of problematic rails.\n\nWith MOD_~{OC}, we can detect overcurrent, and automatically disable the card."
		(exclude_from_sim no)
		(at 210.185 41.622 0)
		(size 34.29 11.718)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "36531d02-781c-41e5-9df4-4162d9890917")
	)
	(text_box "The management controller shall read MOD_~{OC} and shut down the card as soon as possible when an overcurrent situation is detected."
		(exclude_from_sim no)
		(at 92.075 88.8813 0)
		(size 22.225 13.3537)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "45113152-2cb6-47f5-ace3-ea2aca7f94f5")
	)
	(text_box "These signals must use +3V3 instead of the MOD_+3V3 as they are either backplane local or must always have a bias to a local voltage reference even when the power is off"
		(exclude_from_sim no)
		(at 104.5816 116.7399 0)
		(size 49.0884 7.0851)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "4e0081c2-376d-4ef4-b1df-45eb61b5ed23")
	)
	(text_box "For the 12 V \"high power\" rail, we don't care as much about the current safety as for the 3.3 V and 5 V rails.\nCards should use the 12 V rail for deriving their own, higher-power supply rails from it.\n\nThus, we use a simple MOSFET based high-side switch and a polyfuse."
		(exclude_from_sim no)
		(at 226.695 106.045 0)
		(size 34.29 16.6251)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "524ca94b-9a0c-41ae-8f7b-a5e840a54a9e")
	)
	(text_box "Default the clock enable to \"off\""
		(exclude_from_sim no)
		(at 19.05 140.97 0)
		(size 15.875 5.1752)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
