		(uuid "5451f6ee-68c2-4aac-b937-8ebdf3d9a7dd")
	)
	(text_box "Bias towards power off"
		(exclude_from_sim no)
		(at 127.635 139.7 0)
		(size 23.5984 6.3499)
		(margins 0.9525 0 0.9525 0)
		(stroke
			(width 0)
