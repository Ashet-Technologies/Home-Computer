			(justify left)
		)
		(uuid "69587e82-667b-42b7-aebe-01d8bbce9c33")
	)
	(text_box "~{PRESENT} should be high if no card is plugged in"
		(exclude_from_sim no)
		(at 127.635 124.46 0)
		(size 43.815 2.5399)
		(margins 0.9525 0 0.9525 0)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "6f36f70c-a0fe-4895-9fab-228e51e11613")
	)
	(text_box "The management controller for each expansion card has several tasks:\n\n1. Detect a cards presence.\n2. Turn the full power for the card on/off.\n3. Turn the ID EEPROM power for the card on/off.\n4. Enable/disable the cards clock input.\n5. Reset the card.\n6. Measure the voltages on each card slot.\n7. Shut down the card on overvoltage.\n8. Communicate with the mainboard over I²C."
		(exclude_from_sim no)
		(at 123.825 50.8 0)
		(size 44.45 21.4358)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "9562d012-4f20-475e-9734-977004d584bc")
	)
	(text_box "These signals must use a power dependent pull up as otherwise we'de violate specs for potentially attached chips as the signal voltage (+3V3) would be larger than MOD_+3V3"
		(exclude_from_sim no)
		(at 102.87 164.465 0)
		(size 50.7999 7.0851)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "af910298-0cc7-428d-9c3e-369cd587b992")
	)
	(text_box "We don't populate the I²C pull-ups for cards, as the platform spec says that the card itself must provide the pull-ups."
		(exclude_from_sim no)
		(at 101.6 186.69 0)
		(size 31.75 8.4466)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "c2fac417-1c77-46ef-920a-95c5d8266b0e")
	)
	(text_box "We don't use additional capacitors on the output as these should be put on the expansion cards, closer to the actual consumer."
		(exclude_from_sim no)
		(at 262.255 36.195 0)
		(size 21.59 9.525)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left)
		)
		(uuid "c46317d0-12d2-41e8-b84f-82ebcaf9fd38")
	)
	(text_box "To enable/disable the slot function, we provide an optional resistor that placed to enable the function."
		(exclude_from_sim no)
		(at 106.68 31.75 0)
		(size 26.67 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "d6ca6751-2e55-4c49-905b-1a971e7da142")
	)
	(text_box "The capacitor and resistor give us an RC element with a time constant of 1 ms, allowing us to soft-start MOD_+12V.\n\nThis prevents capacitor load inrush when we enable the power rail."
		(exclude_from_sim no)
		(at 261.62 121.1049 0)
		(size 22.225 14.7851)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type color)
			(color 255 255 255 1)
		)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left top)
		)
		(uuid "e78acc29-1c13-42a9-bcc3-43012d33bd35")
	)
	(text_box "We're not limiting the MOD_+3V3_ID rail to 20 mA, but 500 mA.\n\nThis is still in-spec, as we can always provide 20 mA over the rail."
		(exclude_from_sim no)
		(at 210.82 13.3349 0)
		(size 34.29 10.1601)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
