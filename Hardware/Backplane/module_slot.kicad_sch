			)
			(justify left)
		)
		(uuid "6591e5d8-745a-4206-a511-c9c3e9413749")
	)
	(text_box "MOD_~{OC} is an open collector output from the switches"
		(exclude_from_sim no)
		(at 127.635 130.175 0)
		(size 43.815 4.445)
		(margins 0.9525 0 0.9525 0)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
